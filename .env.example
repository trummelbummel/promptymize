# Copy to `.env` and fill in (never commit `.env`).

# ------------------------------------------------------------
# Braintrust configuration
# ------------------------------------------------------------

# Braintrust is required for stepwise-evaluation and prompt-scorer eval runs.

# API key for Braintrust (required for eval flows in staging/production).
BRAINTRUST_API_KEY=

# Optional: explicit project id if your Braintrust setup requires it.
# BRAINTRUST_PROJECT_ID=

# Optional: project name when project id is not set (default: auto-prompt).
# BRAINTRUST_PROJECT_NAME=

# ------------------------------------------------------------
# Local DSPy LLM configuration
# ------------------------------------------------------------

# Local LLM to use dspy.
DSPY_MODEL=llama-3.3-70b-versatile
DSPY_API_BASE=https://api.groq.com/openai/v1/chat/completions
# set DSPY_API_KEY as environmen variable
# Optional: generation limits for DSPy (used by dspy.LM).
DSPY_TEMPERATURE="0.0"
DSPY_MAX_TOKENS="256"


# Optional: enable real integration tests (requires sources/data/**/page.md).
AUTO_PROMPT_RUN_REAL_INTEGRATION=1